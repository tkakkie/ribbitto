package view

import "github.com/tkakkie/ribbitto/internal/web/i18n"

// SetupForm retains only non-secret values and per-field message IDs.
type SetupForm struct {
	Values map[string]string
	Errors map[string]string
}

// Setup renders the first-run setup form.
templ Setup(stylesheetURL string, form SetupForm) {
	@layout(stylesheetURL, i18n.T(ctx, "setup.page_title")) {
		@welcomeLayout() {
			<h1 class="text-heading font-bold text-fg">{ i18n.T(ctx, "setup.title") }</h1>
			<form method="post" action="/setup" class="flex flex-col gap-4">
				for _, field := range []struct{ name, kind, autocomplete string }{
					{"token", "password", "off"},
					{"organization_name", "text", "organization"},
					{"slug", "text", "off"},
					{"display_name", "text", "nickname"},
					{"handle", "text", "off"},
					{"email", "email", "username"},
					{"password", "password", "new-password"},
				} {
					@textField(field.name, field.kind, field.autocomplete, form.Values[field.name], "setup."+field.name, form.Errors[field.name])
				}
				@submitButton(buttonWelcomePrimary, "setup.submit")
			</form>
		}
	}
}
