package view

import "github.com/tkakkie/ribbitto/internal/web/i18n"

// SignUpForm retains only non-secret values and per-field message IDs.
type SignUpForm struct {
	Values map[string]string
	Errors map[string]string
}

// SignUp renders the account registration form.
templ SignUp(stylesheetURL string, form SignUpForm) {
	@layout(stylesheetURL, i18n.T(ctx, "signup.page_title")) {
		@welcomeLayout() {
			<h1 class="text-heading font-bold text-fg">{ i18n.T(ctx, "signup.title") }</h1>
			<form method="post" action="/signup" class="flex flex-col gap-4">
				for _, field := range []struct{ name, kind, autocomplete string }{
					{"display_name", "text", "nickname"},
					{"handle", "text", "off"},
					{"email", "email", "username"},
					{"password", "password", "new-password"},
				} {
					@textField(field.name, field.kind, field.autocomplete, form.Values[field.name], "setup."+field.name, form.Errors[field.name])
				}
				@submitButton(buttonWelcomePrimary, "signup.submit")
			</form>
		}
	}
}
