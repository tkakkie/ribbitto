package view

import "github.com/tkakkie/ribbitto/internal/web/i18n"

// OrgPage is what the organisation page shows.
type OrgPage struct {
	OrganizationName string
	DisplayName      string
	Handle           string
	Role             string // "owner" or "member"
}

// OrgHome renders an organisation's home page.
templ OrgHome(stylesheetURL string, page OrgPage) {
	@layout(stylesheetURL) {
		<main class="mx-auto flex min-h-screen max-w-xl flex-col justify-center gap-4 p-8">
			<h1 class="text-heading font-bold text-fg">{ page.OrganizationName }</h1>
			<p class="text-body text-muted">
				{ i18n.T(ctx, "hello.signed_in_as") }
				<span class="font-semibold text-fg">{ page.DisplayName }</span>
				<span class="text-muted">{ "@" + page.Handle }</span>
				· { i18n.T(ctx, "org.role." + page.Role) }
			</p>
			@SignOutButton()
		</main>
	}
}
