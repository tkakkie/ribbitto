package view

import (
	"fmt"
	"github.com/tkakkie/ribbitto/internal/web/i18n"
)

// ChannelImageURL is the versioned URL of a channel illustration key. A new
// artwork version changes this one place (docs/brand.md).
func ChannelImageURL(key string) string {
	return "/static/channel-images-v1/" + key + ".svg"
}

// The header is above the fold; sidebar entries may scroll out of view.
templ channelImage(src string, header bool) {
	// The pinned generator clears children even for context-free components.
	{{ _ = ctx }}
	{{ size := 24 }}
	if header {
		{{ size = 32 }}
	}
	<img
		src={ src }
		width={ fmt.Sprint(size) }
		height={ fmt.Sprint(size) }
		alt=""
		if !header {
			loading="lazy"
		}
		decoding="async"
		class="inline-block shrink-0 rounded-md align-middle"
	/>
}

// welcomeImages is the welcome card's decorative set: four scenes, one per
// corner of the palette, so the brand side shows what channels look like.
var welcomeImages = [...]string{"lake", "flowers", "moon", "kite"}

// welcomeComposition shows a few channel illustrations on the brand side.
templ welcomeComposition() {
	{{ _ = ctx }}
	<div aria-hidden="true" class="flex flex-wrap gap-3">
		for i, key := range welcomeImages {
			<img
				src={ ChannelImageURL(key) }
				width="64"
				height="64"
				alt=""
				decoding="async"
				class={ "size-16 rounded-xl bg-bg shadow-block", templ.KV("mt-4", i%2 == 1) }
			/>
		}
	</div>
}

// imagePicker shares native radio controls between creation and the overview.
// A fieldset names the group; native inputs keep keyboard and no-script behavior.
templ imagePicker(keys []string, selected string) {
	<fieldset class="flex flex-col gap-2">
		<legend class="font-semibold">{ i18n.T(ctx, "illustration.title") }</legend>
		<label class="flex min-h-11 items-center gap-2">
			<input type="radio" name="image" value="" checked?={ selected == "" }/>
			{ i18n.T(ctx, "illustration.default") }
		</label>
		<div class="grid grid-cols-3 gap-2">
			for _, key := range keys {
				<label class="flex min-h-11 cursor-pointer items-center gap-1 rounded-md border border-border-strong p-1 hover:bg-hover">
					<input type="radio" name="image" value={ key } checked?={ selected == key }/>
					@channelImage(ChannelImageURL(key), false)
					<span class="sr-only">{ i18n.T(ctx, "illustration.option." + key) }</span>
				</label>
			}
		</div>
	</fieldset>
}
