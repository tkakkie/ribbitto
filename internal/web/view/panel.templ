package view

import (
	"github.com/tkakkie/ribbitto/internal/web/i18n"
	"time"
)

// Side panels, named by their URL segment below the conversation's URL.
const (
	PanelMembers  = "members"
	PanelOverview = "overview"
)

func panelTitle(panel string) string {
	if panel == PanelMembers {
		return "people.title"
	}
	return "overview.title"
}

// conversationQuery keeps an older page's own parameters on every panel and
// close link, so a panel never moves the conversation to the latest page.
func conversationQuery(page ChannelPage) string {
	if page.Query == "" {
		return ""
	}
	return "?" + page.Query
}

func querySeparator(page ChannelPage) string {
	if page.Query == "" {
		return "?"
	}
	return "&"
}

// panelURL opens a panel beside the conversation shown, feed or topic.
func panelURL(page ChannelPage, panel string) string {
	return conversationURL(page) + "/" + panel + conversationQuery(page)
}

// panelControls open the panels with ordinary links: each page load gives
// the one stream the interests of the page (decisions 30 and 31).
templ panelControls(page ChannelPage) {
	@panelControl(page, PanelMembers, "people.control") {
		if page.Panel == PanelMembers {
			@Icon("people-filled", 20)
		} else {
			@Icon("people-regular", 20)
		}
	}
	@panelControl(page, PanelOverview, "") {
		if page.Panel == PanelOverview {
			@Icon("info-filled", 20)
		} else {
			@Icon("info-regular", 20)
		}
	}
}

// panelControl marks the open panel's control with aria-current="true";
// "page" stays with the conversation's link in the sidebar. An empty label
// makes the control icon-only, named by the panel title.
templ panelControl(page ChannelPage, panel, label string) {
	{{ open := page.Panel == panel }}
	<a
		id={ "panel-control-" + panel }
		href={ templ.SafeURL(panelURL(page, panel)) }
		if open {
			aria-current="true"
		}
		if label == "" {
			aria-label={ i18n.T(ctx, panelTitle(panel)) }
		} else {
			aria-label={ i18n.T(ctx, label) }
		}
		class={ "inline-flex min-h-11 min-w-11 shrink-0 items-center justify-center gap-2 rounded-md px-2 text-body transition-feedback motion-safe:active:scale-96", templ.KV("bg-selected font-semibold text-on-selected", open), templ.KV("text-muted hover:bg-hover hover:text-fg", !open) }
	>
		{ children... }
		if label != "" {
			<span class="max-desk:hidden">{ i18n.T(ctx, label) }</span>
		}
	</a>
}

// sheetHeight caps a panel's bottom sheet below desk: members and the
// overview take at most 80 %, so a later panel, such as the reply chain,
// can take the whole height without new structure.
func sheetHeight(panel string) string {
	if panel == PanelMembers || panel == PanelOverview {
		return "max-desk:max-h-4/5"
	}
	return "max-desk:max-h-full"
}

// sidePanel is the block beside the conversation from the wide breakpoint;
// below it the block covers the conversation over a dimmed page, whose
// dimmed area is a link that closes it: an overlay on the conversation's
// right side, below desk a bottom sheet. The heading takes focus when the
// panel opens; side-panel-v3.js makes the covering panel a modal dialog,
// adds Escape and returns focus.
templ sidePanel(page ChannelPage) {
	{{ closeURL := conversationURL(page) + conversationQuery(page) }}
	// Pointer-only: the close link and Escape serve the keyboard and
	// assistive technology.
	<a id="panel-backdrop" href={ templ.SafeURL(closeURL) } tabindex="-1" aria-hidden="true" class="hidden max-wide:fixed max-wide:inset-0 max-wide:z-20 max-wide:block max-wide:bg-scrim"></a>
	<aside id="side-panel" aria-labelledby="panel-heading" class={ "flex w-panel shrink-0 flex-col overflow-y-auto overscroll-contain rounded-xl bg-bg shadow-block max-wide:absolute max-wide:inset-y-0 max-wide:right-0 max-wide:z-20 max-wide:shadow-popover max-desk:fixed max-desk:inset-x-0 max-desk:top-auto max-desk:w-auto max-desk:rounded-b-none max-desk:pb-safe-0", sheetHeight(page.Panel) }>
		<header class="flex shrink-0 items-center gap-2 border-b border-border py-2 pl-5 pr-2">
			<h2 id="panel-heading" tabindex="-1" autofocus class="min-w-0 flex-1 break-words text-title font-semibold">{ i18n.T(ctx, panelTitle(page.Panel)) }</h2>
			<a id="panel-close" href={ templ.SafeURL(closeURL) } aria-label={ i18n.T(ctx, "panel.close") } class="flex size-11 shrink-0 items-center justify-center rounded-md text-muted hover:bg-hover hover:text-fg transition-feedback motion-safe:active:scale-96">
				@Icon("dismiss-regular", 20)
			</a>
		</header>
		if page.Panel == PanelMembers {
			@membersPanel(page)
		} else {
			@overviewPanel(page)
		}
	</aside>
}

// overviewPanel leaves room for later sections, such as pins (#880).
// Where it covers the header's Mark as read, it submits the same #read-form.
templ overviewPanel(page ChannelPage) {
	<div class="flex flex-col gap-4 px-5 py-4">
		<p class="flex items-center gap-2 break-words text-title font-semibold">
			@channelImage(page.Current.ImageURL, true)
			<span dir="auto" class="min-w-0">{ page.Current.Name }</span>
		</p>
		if readable(page) && page.FirstUnread > 0 {
			<div class="flex wide:hidden">
				@submitButtonFor(buttonSecondary, "reading.mark", "read-form")
			</div>
		}
		<details open?={ page.OverviewImageError != "" }>
			<summary class="min-h-11 cursor-pointer text-brand underline">{ i18n.T(ctx, "illustration.change") }</summary>
			<form method="post" action={ panelURL(page, PanelOverview) } class="flex flex-col gap-2">
				@imagePicker(page.ImageKeys, page.Current.Image, "overview-image-error", page.OverviewImageError)
				@submitButton(buttonPrimary, "illustration.save")
			</form>
		</details>
		<dl class="flex flex-col gap-1">
			<dt class="text-caption text-muted">{ i18n.T(ctx, "overview.created") }</dt>
			<dd><time datetime={ page.Current.Created.UTC().Truncate(time.Millisecond).Format(time.RFC3339Nano) }>{ page.Current.Created.UTC().Format("2006-01-02") }</time></dd>
		</dl>
		@textLink(panelURL(page, PanelMembers), "people.title", "")
		<h3 class="font-semibold">{ i18n.T(ctx, "topic.list") }</h3>
		<ul class="flex flex-col gap-1">
			for _, topic := range page.Topics {
				// A long name wraps instead of widening the panel; below desk the
				// whole row is the target, so a one-character name still has 44 px.
				<li class="break-words">
					<a href={ templ.SafeURL(ConversationURL(page.Organization.Slug, page.Current.ID, &topic.ID)) } dir="auto" class="inline-flex min-h-9 items-center gap-2 text-fg wrap-anywhere hover:text-brand max-desk:flex max-desk:min-h-11">
						@Icon("branch-regular", 16)
						{ topicName(ctx, topic) }
					</a>
				</li>
			}
		</ul>
	</div>
}
