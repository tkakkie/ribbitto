package view

import "github.com/tkakkie/ribbitto/internal/web/i18n"

// PinLimit explains, without JavaScript, that the channel has as many pins as
// it may hold (409); nothing was evicted. backURL returns to the message.
templ PinLimit(stylesheetURL, backURL string) {
	@layout(stylesheetURL, i18n.T(ctx, "pins.limit_title")) {
		@welcomeLayout() {
			<h1 class="text-heading font-bold text-fg">{ i18n.T(ctx, "pins.limit_title") }</h1>
			<p role="alert" class="text-body text-muted">{ i18n.T(ctx, "pins.error.limit") }</p>
			@textLink(backURL, "pins.back", "")
		}
	}
}

// TooManyRequests tells a client that has used up its attempts to wait.
templ TooManyRequests(stylesheetURL string) {
	@layout(stylesheetURL, i18n.T(ctx, "ratelimit.title")) {
		@welcomeLayout() {
			<h1 class="text-heading font-bold text-fg">{ i18n.T(ctx, "ratelimit.title") }</h1>
			<p class="text-body text-muted">{ i18n.T(ctx, "ratelimit.message") }</p>
		}
	}
}
