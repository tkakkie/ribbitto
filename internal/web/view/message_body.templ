package view

import (
	"context"
	"strings"

	"github.com/tkakkie/ribbitto/internal/kernel"
	"github.com/tkakkie/ribbitto/internal/web/i18n"
)

// BodyKind says what a chat_v1 block or inline node is (decision 39).
type BodyKind int

// The chat_v1 blocks and inline nodes. Text is both a text block and a run
// of plain text inside one.
const (
	BodyText BodyKind = iota
	BodyQuote
	BodyCodeBlock
	BodyBold
	BodyItalic
	BodyCode
	BodyLink
	BodyMember
)

// BodyBlock is one block of a chat_v1 body: Lines for text and quotes, Code
// for a fenced code block.
type BodyBlock struct {
	Kind  BodyKind
	Lines [][]BodyInline
	Code  string
}

// BodyInline is one inline node. Text is plain text, a code span or a link's
// URL; Children are a bold or italic node's content. A member reference
// carries the member's current names, its display name already converted
// like an author's; an empty Handle means it could not be resolved and
// MemberID is empty too.
type BodyInline struct {
	Kind                BodyKind
	Text                string
	Children            []BodyInline
	DisplayName, Handle string
	MemberID            kernel.ID
}

// webURL is the link allow-list, checked again here although only the
// parser makes links, so no other scheme can reach an href. The href takes
// the string, never templ.SafeURL, so templ's own URL sanitising applies too.
func webURL(url string) bool {
	return strings.HasPrefix(url, "https://") || strings.HasPrefix(url, "http://")
}

// UnknownMember is the localised placeholder for a member reference the
// organisation's directory did not resolve, the same in a rendered body and
// in its text (conversation.Entry.Text).
func UnknownMember(ctx context.Context) string {
	return "@" + i18n.T(ctx, "message.unknown_member")
}

// messageBody renders a plain_text body exactly as before chat_v1, and a
// chat_v1 body node by node. Every block and inline element isolates its
// direction. Nothing in it depends on the reader but the language of the
// unresolved-member placeholder, so the stream's shared renders stay valid.
templ messageBody(entry Message) {
	if entry.Blocks == nil {
		<p id={ "body-" + MessageDOMID(entry.ID) } dir="auto" class="whitespace-pre-wrap break-words text-title">{ entry.Body }</p>
	} else {
		<div id={ "body-" + MessageDOMID(entry.ID) } dir="auto" class="flex flex-col gap-2 break-words text-title">
			for _, block := range entry.Blocks {
				switch block.Kind {
					case BodyCodeBlock:
						<pre dir="auto" class="overflow-x-auto rounded-md bg-hover p-3 font-mono text-body"><code>{ block.Code }</code></pre>
					case BodyQuote:
						<blockquote dir="auto" class="whitespace-pre-wrap border-l-4 border-border pl-3 text-muted">
							@bodyLines(block.Lines)
						</blockquote>
					default:
						<p dir="auto" class="whitespace-pre-wrap">
							@bodyLines(block.Lines)
						</p>
				}
			}
		</div>
	}
}

templ bodyLines(lines [][]BodyInline) {
	for i, line := range lines {
		@bodyInlines(line)
		if i+1 < len(lines) {
			<br/>
		}
	}
}

templ bodyInlines(nodes []BodyInline) {
	for _, node := range nodes {
		switch node.Kind {
			case BodyBold:
				<strong dir="auto">
					@bodyInlines(node.Children)
				</strong>
			case BodyItalic:
				<em dir="auto">
					@bodyInlines(node.Children)
				</em>
			case BodyCode:
				<code dir="auto" class="rounded-sm bg-hover px-1 font-mono text-body">{ node.Text }</code>
			case BodyLink:
				if webURL(node.Text) {
					<a href={ node.Text } rel="noopener noreferrer" dir="auto" class="text-brand underline wrap-anywhere">{ node.Text }</a>
				} else {
					{ node.Text }
				}
			case BodyMember:
				<bdi
					if node.MemberID != (kernel.ID{}) {
						data-member-id={ idValue(node.MemberID) }
					}
					class="rounded-sm bg-selected px-1 data-own-mention:outline-2 data-own-mention:outline-brand"
				>
					if node.Handle == "" {
						{ UnknownMember(ctx) }
					} else {
						@MemberName(node.DisplayName, node.Handle)
					}
				</bdi>
			default:
				{ node.Text }
		}
	}
}
