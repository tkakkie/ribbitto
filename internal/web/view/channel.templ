package view

import (
	"fmt"
	"github.com/tkakkie/ribbitto/internal/domain"
	"github.com/tkakkie/ribbitto/internal/web/i18n"
)

// ChannelPage holds the sidebar, conversation and channel creation form.
type ChannelPage struct {
	Organization              domain.Organization
	DisplayName, Handle, Role string
	Current                   domain.Channel
	Channels                  []domain.Channel
	Name, Error               string
	Body, BodyError           string
	Messages                  []Message
	// Older reports that messages before Messages[0] exist.
	Older bool
	// Before is the event_seq bound of an older page; 0 shows the latest.
	Before int64
	// EventCursor starts replay after the latest page snapshot; nil on older pages.
	EventCursor *int64
}

// ChannelURL identifies a channel by its stable UUID, never its name.
func ChannelURL(slug string, id domain.ID) string {
	return fmt.Sprintf("/organizations/%s/channels/%x-%x-%x-%x-%x", slug, id[:4], id[4:6], id[6:8], id[8:10], id[10:])
}

// olderURL links to the page before the oldest message shown.
func olderURL(page ChannelPage) string {
	return fmt.Sprintf("%s?before=%d", ChannelURL(page.Organization.Slug, page.Current.ID), page.Messages[0].EventSeq)
}

// Channel renders the desktop chat layout.
templ Channel(stylesheetURL string, page ChannelPage) {
	@layout(stylesheetURL, page.Current.Name+" · "+page.Organization.Name) {
		<div
			if page.EventCursor != nil && page.Before == 0 {
				data-event-cursor={ fmt.Sprint(*page.EventCursor) }
				hx-ext="sse"
				sse-connect={ fmt.Sprintf("%s/events?after=%d", ChannelURL(page.Organization.Slug, page.Current.ID), *page.EventCursor) }
			}
			class="flex h-dvh text-body"
		>
			<nav aria-label={ i18n.T(ctx, "channel.organizations") } class="w-17 shrink-0 border-r border-border bg-rail p-3">
				<ul>
					<li><a href={ templ.SafeURL("/organizations/" + page.Organization.Slug + "/") } aria-label={ page.Organization.Name } class="flex min-h-11 items-center justify-center rounded-md bg-brand px-2 font-semibold text-on-brand">{ string([]rune(page.Organization.Name)[:1]) }</a></li>
				</ul>
			</nav>
			<aside class="flex w-68 shrink-0 flex-col overflow-y-auto border-r border-border bg-sidebar">
				<header class="border-b border-border px-4 py-3">
					<p class="break-words text-title font-semibold">{ page.Organization.Name }</p>
				</header>
				<nav aria-label={ i18n.T(ctx, "channel.list") } class="p-3">
					<p class="px-3 pb-2 text-caption font-semibold text-muted">{ i18n.T(ctx, "channel.list") }</p>
					<ul class="flex flex-col gap-1">
						for _, c := range page.Channels {
							<li>
								if c.ID == page.Current.ID {
									<a href={ templ.SafeURL(ChannelURL(page.Organization.Slug, c.ID)) } aria-current="page" class="block break-words rounded-sm border-l-3 border-brand bg-selected px-3 py-2 font-semibold text-on-selected">{ c.Name }</a>
								} else {
									<a href={ templ.SafeURL(ChannelURL(page.Organization.Slug, c.ID)) } class="block break-words rounded-sm border-l-3 border-transparent px-3 py-2 text-fg hover:bg-surface">{ c.Name }</a>
								}
							</li>
						}
					</ul>
				</nav>
				<form method="post" action={ "/organizations/" + page.Organization.Slug + "/channels" } class="flex flex-col gap-2 border-t border-border p-4">
					<label for="channel-name" class="font-semibold">{ i18n.T(ctx, "channel.name") }</label>
					<input id="channel-name" name="name" value={ page.Name } required aria-invalid={ fmt.Sprint(page.Error != "") } aria-describedby="channel-name-help" class="min-h-11 w-full rounded-md border border-border-strong bg-input px-3 py-2 text-fg"/>
					if page.Error != "" {
						<p id="channel-name-help" role="alert" class="text-danger">{ i18n.T(ctx, page.Error) }</p>
					} else {
						<p id="channel-name-help" class="text-caption text-muted">{ i18n.T(ctx, "channel.name_help") }</p>
					}
					<button type="submit" class="min-h-11 rounded-md bg-brand px-3 py-2 font-semibold text-on-brand">{ i18n.T(ctx, "channel.create") }</button>
				</form>
				<footer class="mt-auto flex flex-col gap-2 border-t border-border p-4">
					<p class="break-words text-caption text-muted">
						// templ drops the white space around a component call, so the
						// spaces are part of the text.
						{ i18n.T(ctx, "hello.signed_in_as") + " " }
						@MemberName(page.DisplayName, page.Handle)
						{ " · " + i18n.T(ctx, "org.role." + page.Role) }
					</p>
					@SignOutButton()
				</footer>
			</aside>
			<main id="conversation" class="flex min-w-0 flex-1 flex-col bg-bg">
				<header class="shrink-0 border-b border-border px-6 py-3"><h1 class="break-words text-title font-semibold">{ page.Current.Name }</h1></header>
				<div id="message-list" role="region" aria-label={ i18n.T(ctx, "message.list") } tabindex="0" class="min-h-0 flex-1 overflow-y-auto">
					// Always present, empty on the oldest page: loading older
					// messages replaces it out of band with the next control.
					<div id="load-older">
						if page.Older {
							<p class="flex justify-center px-6 pt-4"><a href={ templ.SafeURL(olderURL(page)) } hx-get={ olderURL(page) } hx-target="#message-items" hx-swap="afterbegin" hx-select="#message-items > li" hx-select-oob="#load-older" class="inline-flex min-h-11 items-center rounded-md border border-border-strong px-3 py-2 text-fg hover:bg-surface">{ i18n.T(ctx, "message.load_older") }</a></p>
						}
					</div>
					<ol
						id="message-items"
						if page.EventCursor != nil && page.Before == 0 {
							sse-swap="message"
							hx-swap="beforeend"
						}
						class="peer flex flex-col gap-4 px-6 py-4 empty:hidden"
					>
						for _, entry := range page.Messages {
							@MessageItem(entry)
						}
					</ol>
					<div class="hidden min-h-full items-center justify-center p-8 peer-empty:flex"><p class="text-muted">{ i18n.T(ctx, "channel.empty") }</p></div>
					if page.Before > 0 {
						// Only an older page reached without JavaScript shows this.
						<p class="px-6 pb-4 text-center"><a href={ templ.SafeURL(ChannelURL(page.Organization.Slug, page.Current.ID)) } class="text-brand underline">{ i18n.T(ctx, "message.newest") }</a></p>
					}
				</div>
				<div id="message-status" role="status" aria-live="polite" aria-atomic="false" aria-relevant="additions" class="sr-only"></div>
				@MessageComposer(page)
			</main>
		</div>
		// Every channel page loads these, outside #conversation: htmx will not
		// run scripts in swapped fragments.
		<script defer src="/static/message-time-v2.js" nonce={ templ.GetNonce(ctx) }></script>
		<script defer src="/static/message-composer-v3.js" nonce={ templ.GetNonce(ctx) }></script>
		<script defer src="/static/message-stream-v2.js" nonce={ templ.GetNonce(ctx) }></script>
		<script defer src="/static/message-history-v2.js" nonce={ templ.GetNonce(ctx) }></script>
	}
}

// MessageComposer renders the posting form, alone for enhanced submissions.
templ MessageComposer(page ChannelPage) {
	<form
		id="message-composer"
		method="post"
		action={ ChannelURL(page.Organization.Slug, page.Current.ID) }
		if page.Before == 0 {
			hx-post={ ChannelURL(page.Organization.Slug, page.Current.ID) }
			hx-target="#message-composer"
			hx-swap="outerHTML"
			hx-disabled-elt="find textarea, find button"
			hx-sync="this:drop"
		}
		class="flex shrink-0 flex-col gap-2 border-t border-border p-4"
	>
		<label for="message-body" class="font-semibold">{ i18n.T(ctx, "message.body") }</label>
		// HTML consumes the first newline after <textarea>; add one so drafts keep theirs.
		<textarea id="message-body" name="body" rows="3" dir="auto" aria-invalid={ fmt.Sprint(page.BodyError != "") } aria-describedby="message-help" class="w-full resize-none rounded-md border border-border-strong bg-input px-3 py-2 text-fg">{ "\n" + page.Body }</textarea>
		if page.BodyError != "" {
			<p id="message-help" role="alert" class="text-danger">{ i18n.T(ctx, page.BodyError) }</p>
		} else {
			<p id="message-help" class="text-caption text-muted">{ i18n.T(ctx, "message.help") }</p>
		}
		<button type="submit" class="min-h-11 self-end rounded-md bg-brand px-4 py-2 font-semibold text-on-brand">{ i18n.T(ctx, "message.send") }</button>
	</form>
}
