package web

import "github.com/tkakkie/ribbitto/internal/web/i18n"

// streamBrowserEntries supplies fake OOB entries only to the browser test.
templ streamBrowserEntries(ids []string, state string) {
	for _, id := range ids {
		<div lang={ i18n.Language(ctx) } id={ id } hx-swap-oob="outerHTML">{ state }</div>
	}
}
