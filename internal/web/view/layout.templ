package view

import "github.com/tkakkie/ribbitto/internal/web/i18n"

// layout wraps every page. title names the page itself; the app name follows
// it, so tabs, history and screen readers tell pages apart (WCAG 2.4.2).
templ layout(stylesheetURL, title string) {
	<!DOCTYPE html>
	<html lang={ i18n.Language(ctx) }>
		<head>
			<meta charset="utf-8"/>
			// cover lets env(safe-area-inset-*) report the insets, which the
			// bottom navigation and composer pad by; app.css insets the
			// body from the sides as the default fit did (docs/ui-code.md).
			// Supporting browsers resize the h-dvh frame with the keyboard,
			// keeping its composer outside the independently scrolling list.
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content"/>
			<meta name="theme-color" media="(prefers-color-scheme: light)" content="#edf4f2"/>
			<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0f1514"/>
			<meta name="htmx-config" content='{"allowEval":false,"allowScriptTags":false,"includeIndicatorStyles":false,"responseHandling":[{"code":"204","swap":false},{"code":"[23]..","swap":true},{"code":"409","swap":true,"error":false},{"code":"422","swap":true,"error":false},{"code":"[45]..","swap":false,"error":true}]}'/>
			<title>{ title + " · " + i18n.T(ctx, "app.title") }</title>
			<link rel="stylesheet" href={ stylesheetURL }/>
			<link rel="icon" type="image/svg+xml" href={ logoURL }/>
			// Not deferred: it must mark the page before the first paint.
			<script src="/static/arrival-v1.js" nonce={ templ.GetNonce(ctx) }></script>
			<script defer src="/static/vendor/htmx-2.0.7.min.js" nonce={ templ.GetNonce(ctx) }></script>
			<script defer src="/static/vendor/htmx-ext-sse-2.2.4.min.js" nonce={ templ.GetNonce(ctx) }></script>
			<script defer src="/static/vendor/idiomorph-ext-0.7.4.min.js" nonce={ templ.GetNonce(ctx) }></script>
			// Every popover follows one focus rule (docs/accessibility.md).
			<script defer src="/static/popover-focus-v1.js" nonce={ templ.GetNonce(ctx) }></script>
		</head>
		<body class="bg-base">
			{ children... }
		</body>
	</html>
}
