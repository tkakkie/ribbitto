package view

import "github.com/tkakkie/ribbitto/internal/web/i18n"

// ComposerQuote stays inside the form while post responses renew its state.
templ ComposerQuote(page ChannelPage, oob bool) {
	<div
		id={ ComposerQuoteID }
		hidden?={ page.Quote == nil }
		if oob {
			hx-swap-oob="outerHTML"
		}
	>
		if page.Quote != nil {
			<div class="flex min-w-0 items-center gap-2 rounded-md border-l-4 border-border bg-surface px-3 py-1">
				<div id="composer-quote-description" class="min-w-0 flex-1">
					<p class="truncate text-caption">@MemberName(page.Quote.DisplayName, page.Quote.Handle)</p>
					if page.QuoteText != nil {
						<label for={ QuoteTextID } class="text-caption">{ i18n.T(ctx, "message.quote_text") }</label>
						<textarea
							id={ QuoteTextID }
							autofocus?={ !page.QuoteInvalid && page.BodyError == "" }
							name="quote_text"
							dir="auto"
							rows="3"
							class="min-h-11 w-full rounded-md border border-border bg-surface px-2 text-body max-desk:text-entry"
							if page.QuoteInvalid {
								aria-invalid="true"
								aria-describedby="quote-error"
							}
						>{ *page.QuoteText }</textarea>
						if page.QuoteInvalid {
							<p id="quote-error" role="alert" class="text-caption text-muted">{ i18n.T(ctx, "message.error.quote") }</p>
						}
					} else {
						<p dir="auto" class="truncate text-caption text-muted">{ page.Quote.Body }</p>
					}
				</div>
				<input type="hidden" name="quote" value={ idValue(page.Quote.ID) }/>
				<button type="submit" form={ QuoteFormID } class="min-h-11 shrink-0 px-2 text-muted hover:text-fg">{ i18n.T(ctx, "message.quote_remove") }</button>
				if page.QuoteText == nil {
					<button type="submit" form={ QuoteFormID } name="part" value={ idValue(page.Quote.ID) } class="min-h-11 px-2 text-caption">{ i18n.T(ctx, "message.quote_part") }</button>
				}
			</div>
		} else {
			<div id="composer-quote-description"></div>
		}
	</div>
}
