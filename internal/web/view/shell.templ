package view

import (
	"fmt"

	"github.com/tkakkie/ribbitto/internal/web/i18n"
)

// appBar is the app's own navigation block at desktop width: the logo, Home
// and, at the bottom, the button for the signed-in member's account menu.
// Items for features that do not exist yet arrive with those features.
templ appBar(page ChannelPage) {
	// Below desk a conversation fills the screen, and the list page has the
	// bottom navigation instead (bottomNav).
	<nav aria-label={ i18n.T(ctx, "app.navigation") } class="flex w-rail shrink-0 flex-col items-center gap-1 rounded-xl bg-rail py-3 shadow-block max-desk:hidden">
		<span class="mb-3">
			@brandLogo(36, "")
		</span>
		// Home marks the current section (aria-current="true"); "page" stays
		// with the one conversation link in the sidebar.
		<ul class="flex w-full flex-col items-center">
			<li>
				<a href={ templ.SafeURL("/organizations/" + page.Organization.Slug + "/") } aria-current="true" class="flex w-16 flex-col items-center gap-1 py-1 text-caption font-semibold text-on-selected">
					<span class="flex h-8 w-11 items-center justify-center rounded-lg bg-selected text-brand">
						@Icon("home-filled", 20)
					</span>
					{ i18n.T(ctx, "app.home") }
				</a>
			</li>
		</ul>
		<div class="mt-auto">
			<button type="button" popovertarget="account-menu" aria-label={ i18n.T(ctx, "account.menu") } class="flex size-11 items-center justify-center rounded-full hover:bg-hover transition-feedback motion-safe:active:scale-96">
				<span aria-hidden="true" class="flex size-9 items-center justify-center rounded-full bg-selected text-title font-semibold text-on-selected">{ avatarInitial(page.DisplayName, page.Handle) }</span>
			</button>
		</div>
	</nav>
}

// bottomNav is the list page's navigation below desk (#970): Home, which is
// this page, and the account menu, each an icon above a short label. It is
// the frame's last row rather than fixed, so the list pane ends above it and
// no row scrolls behind it; its padding keeps the items above the safe area.
templ bottomNav(page ChannelPage) {
	<nav aria-label={ i18n.T(ctx, "app.navigation") } class="-mx-2 flex shrink-0 border-t border-border bg-rail pb-safe-0 desk:hidden">
		<a href={ templ.SafeURL("/organizations/" + page.Organization.Slug + "/channels") } aria-current="page" class="flex h-14 flex-1 flex-col items-center justify-center gap-0.5 text-caption font-semibold text-on-selected">
			<span class="flex h-8 w-11 items-center justify-center rounded-lg bg-selected text-brand">
				@Icon("home-filled", 20)
			</span>
			{ i18n.T(ctx, "app.home") }
		</a>
		// The same invoker as the app bar's: the popover reports its open
		// state, so it never takes aria-current.
		<button type="button" popovertarget="account-menu" aria-label={ i18n.T(ctx, "account.menu") } class="flex h-14 flex-1 flex-col items-center justify-center gap-0.5 text-caption text-muted hover:text-fg transition-feedback motion-safe:active:scale-96">
			<span aria-hidden="true" class="flex size-8 items-center justify-center rounded-full bg-selected text-body font-semibold text-on-selected">{ avatarInitial(page.DisplayName, page.Handle) }</span>
			{ i18n.T(ctx, "account.label") }
		</button>
	</nav>
}

// accountMenu is one popover for both invokers, the app bar's button and the
// bottom navigation's. It sits in the frame, outside both bars, because a
// popover inside an ancestor hidden at the current width cannot show. As an
// HTML popover it opens, closes on Escape and on an outside tap, and returns
// focus without JavaScript. Below desk it is a bottom sheet above the safe
// area, narrow enough in landscape to stay clear of a notch.
templ accountMenu(page ChannelPage) {
	// Opening moves focus to the first line (the browser's popover autofocus),
	// since the sheet covers the bottom navigation's button (#1102). Text, not
	// sign-out, so a repeated Enter or Space acts on nothing.
	<div id="account-menu" popover class="inset-auto bottom-3 left-24 m-0 w-64 rounded-xl border border-border bg-surface p-3 text-body text-fg shadow-popover max-desk:inset-x-0 max-desk:bottom-0 max-desk:mx-auto max-desk:w-full max-desk:max-w-md max-desk:rounded-b-none max-desk:border-b-0 max-desk:p-4 max-desk:pb-safe-4">
		<p tabindex="-1" autofocus class="break-words text-caption text-muted">
			// templ drops the white space before a component call but keeps
			// it after one, so only the first space is part of the text.
			{ i18n.T(ctx, "hello.signed_in_as") + " " }
			@MemberName(page.DisplayName, page.Handle)
			{ "· " + i18n.T(ctx, "org.role." + page.Role) }
		</p>
		<div class="mt-3 flex flex-col items-start gap-3">
			@SignOutButton()
			<form method="post" action="/signout/others">
				@submitButton(buttonSecondary, "signout.others.submit")
			</form>
		</div>
	</div>
}

// channelCreateForm opens from the sidebar's add button as a popover; after a
// failed submit it is rendered in place instead, so the error shows and can
// be reached without JavaScript.
templ channelCreateForm(page ChannelPage, popover bool) {
	<form
		id="channel-create"
		method="post"
		action={ "/organizations/" + page.Organization.Slug + "/channels" }
		if popover {
			popover
		}
		// A display utility would override the browser's hiding of a closed
		// popover, so the popover form is flex only while open. Below desk it
		// keeps 16 px from both edges, so it fits a 320 px screen. At every
		// width it may stretch down to 16 px from the bottom, capped at its
		// content height, so in a short viewport (a phone on its side, or a
		// zoomed desktop, #1076) the popover's own overflow scrolls to the
		// submit button (a fit-content height never stops at the inset).
		class={ "flex-col gap-2 text-body text-fg", templ.KV("hidden open:flex inset-auto bottom-4 left-24 top-20 m-0 h-auto max-h-fit w-72 max-desk:inset-x-4 max-desk:w-auto rounded-xl border border-border bg-surface p-4 shadow-popover", popover), templ.KV("flex mx-1 mt-3 rounded-xl bg-surface p-3 shadow-block", !popover) }
	>
		<label for="channel-name" class="font-semibold">{ i18n.T(ctx, "channel.name") }</label>
		@textInput(inputProps{ID: "channel-name", Name: "name", Value: page.Name, Required: true, Invalid: fmt.Sprint(page.Error != ""), DescribedBy: "channel-name-help"})
		if page.Error != "" {
			<p id="channel-name-help" role="alert" class="text-danger">{ i18n.T(ctx, page.Error) }</p>
		} else {
			<p id="channel-name-help" class="text-caption text-muted">{ i18n.T(ctx, "channel.name_help") }</p>
		}
		@imagePicker(page.ImageKeys, page.Image, "channel-image-error", page.CreateImageError)
		@submitButton(buttonPrimary, "channel.create")
	</form>
}
