package view

import (
	"fmt"
	"github.com/tkakkie/ribbitto/internal/kernel"
	"github.com/tkakkie/ribbitto/internal/web/i18n"
)

func idValue(id kernel.ID) string {
	return fmt.Sprintf("%x-%x-%x-%x-%x", id[:4], id[4:6], id[6:8], id[8:10], id[10:])
}

// branchForm appears only while a message in the list is checked, through CSS
// alone, so it works the same without JavaScript (decision 19) and from the
// first paint. display:none keeps its controls out of the tab order and the
// accessibility tree until then. It then covers the composer's area instead
// of joining the column, so appearing never resizes or scrolls the message
// list. Every rule needs :has(), so a browser without it keeps the plain
// column. After a plain failed submit nothing is checked, so the form stays
// in the column to show its error. Below the short height the conversation
// scrolls, which would carry a covering form away from the composer, so the
// form takes the hidden composer's place in the column instead (#1056).
templ branchForm(page ChannelPage) {
	<form
		id="branch-form"
		method="post"
		action={ ChannelURL(page.Organization.Slug, page.Current.ID) + "/branch" }
		hx-post={ ChannelURL(page.Organization.Slug, page.Current.ID) + "/branch" }
		hx-target="#branch-feedback"
		hx-swap="outerHTML"
		hx-sync="this:drop"
		class={ "mx-auto flex w-full max-w-reading shrink-0 flex-wrap items-center gap-2 bg-bg px-6 py-3 text-body max-desk:px-4 max-desk:pb-safe-3", templ.KV("peer-not-has-checked/list:hidden peer-has-checked/list:absolute peer-has-checked/list:inset-x-0 peer-has-checked/list:bottom-0 short:peer-has-checked/list:static", page.BranchError == "") }
	>
		if page.Topic != nil {
			<input type="hidden" name="return_topic" value={ idValue(page.Topic.ID) }/>
		}
		<input type="hidden" name="before" value={ fmt.Sprint(page.Before) }/>
		if page.Around > 0 {
			<input type="hidden" name="around" value={ fmt.Sprint(page.Around) }/>
		}
		if !latest(page) {
			// An error page keeps the visit's divider, like the older link.
			<input type="hidden" name="unread" value={ fmt.Sprint(page.FirstUnread) }/>
		}
		<label for="branch-to">{ i18n.T(ctx, "topic.branch_to") }</label>
		<select id="branch-to" name="to" class="min-h-11 max-w-full rounded-md border border-border-strong bg-input px-3 text-fg max-desk:text-entry">
			<option value="">{ i18n.T(ctx, "topic.branch_new") }</option>
			for _, topic := range page.Topics {
				if page.Topic == nil || page.Topic.ID != topic.ID {
					<option value={ idValue(topic.ID) }>{ topicName(ctx, topic) }</option>
				}
			}
		</select>
		<label for="branch-name">{ i18n.T(ctx, "topic.branch_new") }</label>
		@textInput(inputProps{ID: "branch-name", Name: "name", Value: page.BranchName})
		@submitButton(buttonPrimary, "topic.branch_submit")
		@BranchFeedback(page.BranchError)
	</form>
}

// BranchFeedback replaces only the feedback, preserving enhanced selections and drafts.
templ BranchFeedback(key string) {
	<div id="branch-feedback" class="w-full text-caption">
		if key != "" {
			<p role="alert" class="text-danger">{ i18n.T(ctx, key) }</p>
		} else {
			<p class="text-muted">{ i18n.T(ctx, "topic.branch_help") }</p>
		}
	</div>
}
