package view

import "github.com/tkakkie/ribbitto/internal/web/i18n"

// SignInForm is what the sign-in page shows again after a failed attempt.
// It never carries the password.
type SignInForm struct {
	SignUpOpen bool
	Email      string
	Error      string // message ID, empty when there is no error
}

// SignIn renders the sign-in page.
templ SignIn(stylesheetURL string, form SignInForm) {
	@layout(stylesheetURL, i18n.T(ctx, "signin.page_title")) {
		<main class="mx-auto flex min-h-screen max-w-sm flex-col justify-center gap-6 p-8">
			<h1 class="text-heading font-bold text-fg">{ i18n.T(ctx, "signin.title") }</h1>
			if form.Error != "" {
				<p role="alert" class="text-body text-danger">{ i18n.T(ctx, form.Error) }</p>
			}
			<form method="post" action="/signin" class="flex flex-col gap-4">
				<label class="flex flex-col gap-1 text-body text-fg">
					{ i18n.T(ctx, "signin.email") }
					<input type="email" name="email" value={ form.Email } autocomplete="username" required class="min-h-11 rounded-md border border-border-strong bg-input px-3 py-2 text-body text-fg"/>
				</label>
				<label class="flex flex-col gap-1 text-body text-fg">
					{ i18n.T(ctx, "signin.password") }
					<input type="password" name="password" autocomplete="current-password" required class="min-h-11 rounded-md border border-border-strong bg-input px-3 py-2 text-body text-fg"/>
				</label>
				<button type="submit" class="min-h-11 rounded-md bg-brand px-4 py-2 text-body font-semibold text-on-brand">{ i18n.T(ctx, "signin.submit") }</button>
			</form>
			if form.SignUpOpen {
				<a href="/signup" class="flex min-h-11 items-center text-body text-brand">{ i18n.T(ctx, "signup.title") }</a>
			}
		</main>
	}
}
