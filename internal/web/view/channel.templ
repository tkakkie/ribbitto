package view

import (
	"context"
	"fmt"
	"github.com/tkakkie/ribbitto/internal/kernel"
	"github.com/tkakkie/ribbitto/internal/web/i18n"
	"net/url"
	"strings"
	"time"
)

// Organization holds the organisation fields displayed by a channel page.
type Organization struct {
	Slug string
	Name string
}

// Channel holds the channel fields a channel page displays.
type Channel struct {
	ID             kernel.ID
	DefaultTopicID kernel.ID
	Name           string
	ImageURL       string
	Image          string
	Created        time.Time
}

// Topic holds the topic fields a channel page displays.
type Topic struct {
	ID        kernel.ID
	Name      string
	IsDefault bool
}

// ChannelPage holds the sidebar, conversation and channel creation form.
type ChannelPage struct {
	// SendKey is the session account's composer preference.
	SendKey string
	// List marks the channel list page, whose content is the sidebar.
	List                       bool
	Reading                    bool // Whether read POSTs are wired.
	Organization               Organization
	DisplayName, Handle, Role  string
	Topic                      *Topic
	Topics                     []Topic
	Current                    Channel
	Channels                   []Channel
	ChannelCounts, TopicCounts map[kernel.ID]int64
	SnapshotSeq                int64
	MemberID                   kernel.ID
	Name, Error                string
	Image, Query               string
	CreateImageError           string
	// OverviewImageError is the image picker's message ID after a failed change.
	OverviewImageError      string
	ImageKeys               []string
	Body, BodyError         string
	BranchError, BranchName string
	Messages                []Message
	// Panel names the side panel open beside the conversation, if any.
	Panel   string
	Members *MemberPage
	// Pins are the overview's entries, read only when that panel is open.
	Pins []Pin
	// Composer preserves absence separately from an empty submitted value.
	Composer *string
	// Quote is the selected original; QuoteUpdate limits swaps to quoted sends.
	Quote *Message
	// QuoteText is present even for an empty submitted part; nil means whole.
	QuoteText    *string
	QuoteInvalid bool
	QuoteUpdate  bool
	// IdempotencyKey is the composer's key for one send (decision 37 (b));
	// like Composer, a 422 keeps the submitted value or its absence.
	IdempotencyKey *string
	// PostedMessageID correlates a successful enhanced post with stream delivery.
	PostedMessageID *kernel.ID
	// PostedTopicID and PostedEventSeq let topic pending posts settle after a move.
	PostedTopicID  kernel.ID
	PostedEventSeq int64
	// SentBody is, on an enhanced 409 whose text starts with it, the stored
	// body of the message the key names: always the requester's own, since
	// posting looks keys up by author. The script removes it, so the 409's
	// field error is not shown.
	SentBody string
	// Older reports that messages before Messages[0] exist.
	Older bool
	// Before is the event_seq bound of an older page; 0 shows the latest.
	Before int64
	// Around is the event_seq an older page is centred on (decision 36), for
	// a message's URL; 0 unless that page is shown.
	Around int64
	// FirstUnread stays the same for the whole visit; zero means nothing was unread.
	FirstUnread int64
	// EventCursor starts replay after every page's snapshot, including history.
	EventCursor *int64
	// Session is the signing-in session's id, never its token, with its
	// expiry and this render's time: the drafts script's horizon and
	// deadline (decision 37 (d)).
	Session                  kernel.ID
	SessionExpires, Rendered time.Time
}

// ChannelURL identifies a channel by its stable UUID, never its name.
func ChannelURL(slug string, id kernel.ID) string {
	return "/organizations/" + slug + "/channels/" + idValue(id)
}

// ChannelListURL names the channel whose topics the list page nests.
func ChannelListURL(slug string, id kernel.ID) string {
	return "/organizations/" + slug + "/channels?channel=" + idValue(id)
}

// ConversationURL identifies a channel feed or a topic within it.
func ConversationURL(slug string, channelID kernel.ID, topicID *kernel.ID) string {
	url := ChannelURL(slug, channelID)
	if topicID != nil {
		url += "/topics/" + idValue(*topicID)
	}
	return url
}

func conversationURL(page ChannelPage) string {
	var id *kernel.ID
	if page.Topic != nil {
		id = &page.Topic.ID
	}
	return ConversationURL(page.Organization.Slug, page.Current.ID, id)
}

func typingURL(page ChannelPage) string {
	topic := page.Current.DefaultTopicID
	if page.Topic != nil {
		topic = page.Topic.ID
	}
	return ConversationURL(page.Organization.Slug, page.Current.ID, &topic) + "/typing"
}

func topicName(ctx context.Context, topic Topic) string {
	if topic.IsDefault {
		return i18n.T(ctx, "topic.default")
	}
	return topic.Name
}

// The history control owns the loaded range, even if live moves empty the list.
func oldestSequence(page ChannelPage) int64 {
	if !page.Older || len(page.Messages) == 0 {
		return 0
	}
	return page.Messages[0].EventSeq
}

// latest reports whether the page is the conversation's latest page: live,
// reading and typing. Older pages, before or around a position, are none of
// these.
func latest(page ChannelPage) bool {
	return page.Before == 0 && page.Around == 0
}

// olderURL links to the page before the oldest message shown.
func olderURL(page ChannelPage) string {
	return fmt.Sprintf("%s?before=%d&unread=%d", conversationURL(page), page.Messages[0].EventSeq, page.FirstUnread)
}

// streamURL declares the page's interests independently of its history URL.
// A panel adds presence or pins; the conversation beside it keeps its own. The
// list page shows only the sidebar, bound to the channel it nests.
func streamURL(page ChannelPage) string {
	want := "sidebar"
	if latest(page) && !page.List {
		want += ",messages,typing"
	}
	if page.Members != nil && page.Members.PresenceAfter != "" {
		want += ",presence"
	}
	if page.Panel == "overview" {
		want += ",pins"
	}
	endpoint := fmt.Sprintf("/organizations/%s/events?after=%d&want=%s&channel=%s", page.Organization.Slug, *page.EventCursor, want, idValue(page.Current.ID))
	if page.Topic != nil {
		endpoint += "&topic=" + idValue(page.Topic.ID)
	}
	if page.Members != nil && page.Members.PresenceAfter != "" {
		endpoint += "&presence-after=" + url.QueryEscape(page.Members.PresenceAfter)
	}
	return endpoint
}

// ChannelScreen renders a feed or topic view in the chat frame. The name
// leaves Channel to the view model.
templ ChannelScreen(stylesheetURL string, page ChannelPage) {
	{{ title := page.Current.Name + " · " + page.Organization.Name }}
	if page.Topic != nil {
		{{ title = topicName(ctx, *page.Topic) + " · " + title }}
	}
	if page.Panel != "" {
		{{ title = i18n.T(ctx, panelTitle(page.Panel)) + " · " + title }}
	}
	@layout(stylesheetURL, title) {
		@channelFrame(page) {
			// The conversation and its panel share one flexible region, which
			// an overlay panel covers.
			<div class="relative flex min-w-0 flex-1 gap-2">
				// Below the short height the conversation scrolls as a whole around a
				// fixed list, so messages stay readable and the composer reachable.
				<main id="conversation" class="relative flex min-w-0 flex-1 flex-col overflow-hidden rounded-xl bg-bg shadow-block max-desk:rounded-none short:overflow-y-auto">
					<header class="flex shrink-0 items-center gap-3 border-b border-border px-6 py-2 max-desk:gap-0 max-desk:px-1">
						// Below the desk breakpoint the list replaces the hidden sidebar; the
						// fragment brings this channel's row into view without JavaScript.
						<a href={ templ.SafeURL(ChannelListURL(page.Organization.Slug, page.Current.ID) + "#" + ChannelDOMID(page.Current.ID)) } aria-label={ i18n.T(ctx, "channel.back") } class="flex size-11 shrink-0 items-center justify-center rounded-full text-muted hover:bg-hover hover:text-fg desk:hidden transition-feedback motion-safe:active:scale-96">
							// A text chevron: the sprite has no back arrow, and a sprite icon
							// hidden at desktop width would have nothing to paint.
							<span aria-hidden="true" class="text-heading">‹</span>
						</a>
						<div class="flex min-w-0 flex-1 items-center gap-2 max-desk:gap-0">
							@channelImage(page.Current.ImageURL, true)
							if page.Topic != nil {
								<a href={ templ.SafeURL(ChannelURL(page.Organization.Slug, page.Current.ID)) } class="min-w-0 truncate text-title text-muted hover:text-brand max-desk:ml-1 max-desk:flex max-desk:min-h-11 max-desk:w-11 max-desk:shrink-0 max-desk:items-center"><span class="truncate">{ page.Current.Name }</span></a>
								@Icon("chevron-right-regular", 20)
								@Icon("branch-regular", 20)
								<h1 class="flex min-w-0 items-center text-title font-semibold max-desk:flex-1">
									<span class="truncate">{ topicName(ctx, *page.Topic) }</span>
									@TopicHeadingCount(page, false)
								</h1>
							} else {
								<h1 class="truncate text-title font-semibold max-desk:ml-1">{ page.Current.Name }</h1>
							}
						</div>
						@panelControls(page)
						if readable(page) {
							@readForm(page)
						}
					</header>
					<p id="stream-stopped" role="status" hidden class="shrink-0 px-6 py-2 text-body text-muted">
						{ i18n.T(ctx, "stream.stopped") }
						<a href={ templ.SafeURL(conversationURL(page)) } class="text-brand underline">{ i18n.T(ctx, "stream.reload") }</a>
					</p>
					<div id={ MessageListID } role="region" aria-label={ i18n.T(ctx, "message.list") } tabindex="0" class="peer/list min-h-0 flex-1 overflow-y-auto short:h-32 short:flex-none">
						// Always present, empty on the oldest page: loading older
						// messages replaces it out of band with the next control.
						<div id="load-older" data-oldest-seq={ fmt.Sprint(oldestSequence(page)) }>
							if page.Older {
								<p class="flex justify-center px-6 pt-4">
									@historyLink(olderURL(page), true) {
										@Icon("arrow-up-regular", 20)
										{ i18n.T(ctx, "message.load_older") }
									}
								</p>
							}
						</div>
						<ol
							id={ MessageItemsID }
							if page.Topic != nil {
								{ TopicAttribute }={ idValue(page.Topic.ID) }
							}
							if page.EventCursor != nil && latest(page) {
								sse-swap="message,messages-moved"
								hx-swap="beforeend"
							}
							class="peer mx-auto flex w-full max-w-reading flex-col gap-6 px-6 py-6 empty:hidden max-desk:max-w-none max-desk:px-4"
						>
							for _, entry := range page.Messages {
								@unreadDivider(entry.EventSeq, page.FirstUnread)
								@MessageItem(entry)
							}
						</ol>
						if latest(page) {
							<ol id={ MessagePendingID } class="mx-auto flex w-full max-w-reading flex-col gap-6 px-6 pb-6 peer-empty:pt-6 empty:hidden max-desk:max-w-none max-desk:px-4"></ol>
							@pendingMessage(page)
						}
						<div id={ MessageEmptyID } class="hidden min-h-full items-center justify-center p-8 peer-empty:flex"><p class="text-muted">{ i18n.T(ctx, "channel.empty") }</p></div>
						if !latest(page) {
							// Only an older page reached by its own URL shows this: a
							// message's link, or "Load older" without JavaScript.
							<p class="px-6 pb-4 text-center">
								@historyLink(conversationURL(page), false) {
									@Icon("chevron-down-regular", 20)
									{ i18n.T(ctx, "message.newest") }
								}
							</p>
						}
					</div>
					<div id={ MessageStatusID } role="status" aria-live="polite" aria-atomic="false" aria-relevant="additions" class="sr-only"></div>
					@branchForm(page)
					// While a message is checked the move form covers this area, which
					// keeps its space so the message list neither shrinks nor scrolls.
					// Below the short height the form takes its place in the column,
					// and the fixed list still neither shrinks nor scrolls.
					<div class={ "mx-auto flex w-full max-w-reading shrink-0 flex-col px-6 pb-4 max-desk:max-w-none max-desk:px-4 max-desk:pb-safe-4", templ.KV("peer-has-checked/list:invisible short:peer-has-checked/list:hidden", page.BranchError == "") }>
						if latest(page) && page.EventCursor != nil {
							<div id={ TypingStatusID } sse-swap="typing" hx-swap="innerHTML" role="status" aria-live="polite" aria-atomic="true" aria-label={ i18n.T(ctx, "activity.label") } class="min-h-6 px-3 text-caption text-muted"></div>
						}
						@messageComposer(page)
					</div>
				</main>
				if page.Panel != "" {
					@sidePanel(page)
				}
			</div>
		}
		// Scripts stay outside swap targets; htmx will not run swapped scripts.
		// read-visibility starts at htmx:load, after every deferred script, so
		// side-panel already answers its panel-cover request whatever the order.
		<script defer src="/static/sidebar-scroll-v2.js" nonce={ templ.GetNonce(ctx) }></script>
		<script defer src="/static/read-visibility-v6.js" nonce={ templ.GetNonce(ctx) }></script>
		<script defer src="/static/branch-selection-v1.js" nonce={ templ.GetNonce(ctx) }></script>
		@pageScript("message-time")
		<script defer src="/static/member-mentions-v1.js" nonce={ templ.GetNonce(ctx) }></script>
		<script defer src="/static/mention-picker-v1.js" nonce={ templ.GetNonce(ctx) }></script>
		<script defer src="/static/message-composer-v21.js" nonce={ templ.GetNonce(ctx) }></script>
		@pageScript("pins-sync")
		<script defer src="/static/quote-selection-v1.js" nonce={ templ.GetNonce(ctx) }></script>
		<script defer src="/static/message-link-v1.js" nonce={ templ.GetNonce(ctx) }></script>
		<script defer src="/static/message-history-v2.js" nonce={ templ.GetNonce(ctx) }></script>
		<script defer src="/static/side-panel-v3.js" nonce={ templ.GetNonce(ctx) }></script>
		<script defer src="/static/sidebar-unread-v3.js" nonce={ templ.GetNonce(ctx) }></script>
		<script defer src="/static/message-stream-v14.js" nonce={ templ.GetNonce(ctx) }></script>
		<script defer src="/static/message-drafts-v7.js" nonce={ templ.GetNonce(ctx) }></script>
	}
}

// channelFrame is the organisation stream around the app bar, the sidebar and
// the page's own blocks. On the list page the sidebar is the page's <main>;
// below the desk breakpoint it fills the screen above the bottom navigation,
// and a conversation hides the bar and the sidebar instead. The server never
// needs the width.
templ channelFrame(page ChannelPage) {
	<div
		id={ OrganizationStreamID }
		{ MemberAttribute }={ idValue(page.MemberID) }
		data-session={ idValue(page.Session) }
		data-session-expires={ fmt.Sprint(page.SessionExpires.UnixMilli()) }
		data-rendered-at={ fmt.Sprint(page.Rendered.UnixMilli()) }
		if page.Topic != nil {
			{ SidebarTopicAttribute }={ idValue(page.Topic.ID) }
		}
		if page.EventCursor != nil {
			{ EventCursorAttribute }={ fmt.Sprint(*page.EventCursor) }
			hx-ext="sse"
			sse-connect={ streamURL(page) }
		}
		class={ "flex h-conversation-viewport gap-2 bg-base p-2 text-body", templ.KV("max-desk:p-0", !page.List), templ.KV("max-desk:flex-col max-desk:pb-0", page.List) }
	>
		if page.EventCursor != nil {
			<form id={ SidebarResyncID } hidden method="post" action={ "/organizations/" + page.Organization.Slug + "/sidebar/resync" } hx-post={ "/organizations/" + page.Organization.Slug + "/sidebar/resync" } hx-trigger={ SidebarResyncEvent } hx-sync="this:drop" hx-swap="none"></form>
		}
		<div id={ StreamSinkID } hidden aria-hidden="true" sse-swap="sidebar,presence" hx-swap="none"></div>
		@appBar(page)
		// Either element is the scrolling pane that sidebar-scroll-v2.js finds.
		if page.List {
			<main class="flex w-sidebar shrink-0 flex-col overflow-y-auto px-1 py-2 max-desk:w-auto max-desk:flex-1">
				@sidebarContent(page)
			</main>
		} else {
			<aside class="flex w-sidebar shrink-0 flex-col overflow-y-auto px-1 py-2 max-desk:hidden">
				@sidebarContent(page)
			</aside>
		}
		{ children... }
		if page.List {
			@bottomNav(page)
		}
		@accountMenu(page)
	</div>
}

// sidebarContent is the sidebar's content: the organisation's name (the list
// page's heading), the channel list and the creation form.
templ sidebarContent(page ChannelPage) {
	if page.List {
		<h1 class="break-words px-3 pb-3 pt-1 text-title font-semibold">{ page.Organization.Name }</h1>
	} else {
		<p class="break-words px-3 pb-3 pt-1 text-title font-semibold">{ page.Organization.Name }</p>
	}
	<nav aria-label={ i18n.T(ctx, "channel.list") }>
		<div class="flex items-center justify-between gap-2 pb-1 pl-3">
			<p class="text-caption font-semibold text-muted">{ i18n.T(ctx, "channel.list") }</p>
			@iconButton("channel.create", "channel-create") {
				@Icon("add-regular", 20)
			}
		</div>
		@ChannelList(page, false)
	</nav>
	// A failed submit shows the form in place, so its error is visible and
	// focusable without JavaScript; otherwise it opens from the add button.
	if page.Error != "" || page.CreateImageError != "" {
		@channelCreateForm(page, false)
	} else {
		@channelCreateForm(page, true)
	}
}

// ChannelListScreen renders the channel list page: the list is the page's
// main content, and at desktop width a block beside it prompts to open a
// channel. It has no read form or composer, so it never reads or posts.
templ ChannelListScreen(stylesheetURL string, page ChannelPage) {
	@layout(stylesheetURL, i18n.T(ctx, "channel.list")+" · "+page.Organization.Name) {
		@channelFrame(page) {
			<div class="flex min-w-0 flex-1 items-center justify-center rounded-xl bg-bg p-8 shadow-block max-desk:hidden">
				<p class="text-muted">{ i18n.T(ctx, "channel.choose") }</p>
			</div>
		}
		<script defer src="/static/sidebar-scroll-v2.js" nonce={ templ.GetNonce(ctx) }></script>
		<script defer src="/static/sidebar-unread-v3.js" nonce={ templ.GetNonce(ctx) }></script>
		<script defer src="/static/message-stream-v14.js" nonce={ templ.GetNonce(ctx) }></script>
		<script defer src="/static/message-drafts-v7.js" nonce={ templ.GetNonce(ctx) }></script>
	}
}

// historyLink shares the paging look while only older links prepend history.
templ historyLink(url string, older bool) {
	<a
		href={ templ.SafeURL(url) }
		if older {
			hx-get={ url }
			hx-target={ "#" + MessageItemsID }
			hx-swap="afterbegin"
			hx-select={ "#" + MessageItemsID + " > li" }
			hx-select-oob="#load-older"
		}
		class="inline-flex min-h-11 items-center gap-2 rounded-full px-3 py-2 text-body text-muted hover:bg-hover hover:text-fg transition-feedback motion-safe:active:scale-96"
	>
		{ children... }
	</a>
}

// A separate page-only item survives shared live replacements. Its sequence
// lets move insertion order it alongside messages without special JavaScript.
templ unreadDivider(seq, firstUnread int64) {
	if firstUnread > 0 && seq == firstUnread {
		<li id="unread-divider" data-event-seq={ fmt.Sprint(firstUnread) } class="flex items-center gap-3">
			<span aria-hidden="true" class="flex-1 border-t border-accent-line"></span>
			<p class="rounded-sm bg-accent px-2 py-1 text-caption font-semibold text-on-accent">{ i18n.T(ctx, "reading.new_messages") }</p>
			<span aria-hidden="true" class="flex-1 border-t border-accent-line"></span>
		</li>
	}
}

// MessageComposer answers an enhanced post: the composer's state and, out of
// band, the signal form with the same generation. It never holds the
// textarea, so text typed while the post was in flight stays (#1173).
templ MessageComposer(page ChannelPage) {
	@composerState(page)
	if page.QuoteUpdate {
		@ComposerQuote(page, true)
	}
	@typingForm(page, true)
}

// Pending markup stays server-owned; its body is filled as text, never HTML.
// Layout mirrors messageItem to preserve its shared stream markup;
// testPendingComposerBrowser guards their geometry within 1 px.
templ pendingMessage(page ChannelPage) {
	<template id={ MessagePendingTemplateID }>
		<li class="relative flex scroll-mt-6 flex-col gap-1 pl-12 max-desk:wrap-anywhere">
			<div class="flex flex-wrap items-baseline gap-x-2 gap-y-1 text-body min-h-9 max-desk:min-h-11 max-desk:items-center">
				<div class="contents max-desk:flex max-desk:min-w-0 max-desk:flex-col">
					<span class="min-w-0 break-words">@MemberName(page.DisplayName, page.Handle)</span>
					<span { PendingSendingAttribute } class="text-caption text-muted desk:min-w-timestamp">{ i18n.T(ctx, "message.sending") }</span>
				</div>
			</div>
			// Keep the empty failure status exposed without adding a flex gap.
			<div>
				<p { PendingBodyAttribute } id={ MessagePendingBodyID } dir="auto" class="whitespace-pre-wrap break-words text-body"></p>
				<form { PendingFormAttribute } hx-trigger={ PendingSendEvent } method="post" action={ conversationURL(page) } hx-post={ conversationURL(page) } hx-target={ "#" + MessageComposerStateID } hx-swap="outerHTML" hx-sync="this:drop" hx-disabled-elt={ `find button[type="submit"]:not([form])` } hx-request={ `{"timeout":30000}` }>
					<input type="hidden" name="body"/>
					<input type="hidden" name="idempotency_key"/>
					<input type="hidden" name="composer"/>
					<input type="hidden" name="cursor"/>
					<p role="status" class="text-caption text-danger"></p>
					<div { PendingActionsAttribute } hidden>
						<button type="submit" aria-describedby={ MessagePendingBodyID } class="min-h-11 px-2 text-brand hover:underline">{ i18n.T(ctx, "message.retry") }</button>
						<button type="button" { PendingEditAttribute } aria-describedby={ MessagePendingBodyID } class="min-h-11 px-2 text-brand hover:underline">{ i18n.T(ctx, "message.edit") }</button>
						<span { PendingEditHelpAttribute } id={ MessagePendingEditHelpID } hidden class="text-caption text-muted">{ i18n.T(ctx, "message.edit.unavailable") }</span>
						<button type="button" { PendingRemoveAttribute } aria-describedby={ MessagePendingBodyID } class="min-h-11 px-2 text-muted hover:underline">{ i18n.T(ctx, "message.remove") }</button>
					</div>
				</form>
			</div>
			<div class="absolute left-0 top-0">@Avatar(page.MemberID, page.DisplayName, page.Handle)</div>
		</li>
	</template>
}

// The textarea and the send button stay outside every swap: only the state
// is replaced, and the button alone is disabled while a post is in flight.
templ messageComposer(page ChannelPage) {
	@mentionPicker(page)
	<form id={ QuoteFormID } hidden method="get" action={ conversationURL(page) + "#" + MessageComposerID } hx-post={ ChannelURL(page.Organization.Slug, page.Current.ID) + "/quote" } hx-target={ "#" + ComposerQuoteID } hx-swap="outerHTML" hx-sync={ "#" + MessageComposerID + ":drop" }>
		// Separate form ownership keeps this out of the chip textarea's POST.
		<input type="hidden" name="quote_text" disabled/>
		if page.Before > 0 {
			<input type="hidden" name="before" value={ fmt.Sprint(page.Before) }/>
		}
		if page.Around > 0 {
			<input type="hidden" name="around" value={ fmt.Sprint(page.Around) }/>
		}
		if !latest(page) {
			<input type="hidden" name="unread" value={ fmt.Sprint(page.FirstUnread) }/>
		}
	</form>
	<form
		id={ MessageComposerID }
		method="post"
		action={ conversationURL(page) }
		if latest(page) {
			{ DraftChannelAttribute }={ idValue(page.Current.ID) }
			if page.Topic != nil {
				{ DraftTopicAttribute }={ idValue(page.Topic.ID) }
			}
			hx-post={ conversationURL(page) }
			hx-target={ "#" + MessageComposerStateID }
			hx-swap="outerHTML"
			hx-disabled-elt={ `find button[type="submit"]:not([form])` }
			hx-sync="this:drop"
			// htmx sets no timeout of its own: a hung send would never end.
			hx-request={ `{"timeout":30000}` }
		}
		class="flex shrink-0 flex-col gap-2 rounded-xl border border-border-strong bg-input p-3"
	>
		@ComposerQuote(page, false)
		<label for={ MessageBodyID } class="font-semibold">{ i18n.T(ctx, "message.body") }</label>
		// HTML consumes the first newline after <textarea>; add one so drafts keep theirs.
		<textarea
			id={ MessageBodyID }
			name="body"
			rows="3"
			dir="auto"
			aria-autocomplete="list"
			aria-controls="mention-listbox"
			aria-invalid={ fmt.Sprint(page.BodyError != "") }
			aria-describedby={ MessageHelpID + " composer-quote-description" }
			aria-description={ i18n.T(ctx, "mention.help") }
			class="w-full field-sizing-content max-h-composer resize-none rounded-md bg-input px-3 py-2 text-title text-fg max-desk:min-h-11 max-desk:text-entry"
		>{ "\n" + page.Body }</textarea>
		<div class="flex items-end justify-between gap-3">
			// The sending status covers the help, which keeps its space, so the
			// composer does not change height while a post is in flight.
			<div class="relative min-w-0">
				@composerState(page)
				// Outside the swapped state, so a 422's answer keeps it; the script
				// inserts one of these texts with textContent (#1179).
				if latest(page) {
					<p
						id={ MessageSendAlertID }
						role="alert"
						{ UnconfirmedAttribute }={ i18n.T(ctx, "message.send_alert.unconfirmed") }
						{ NotSentAttribute }={ i18n.T(ctx, "message.send_alert.not_sent") }
						{ StillUnconfirmedAttribute }={ i18n.T(ctx, "message.send_alert.still_unconfirmed") }
						{ RecoveredAttribute }={ i18n.T(ctx, "message.send_alert.recovered") }
						{ RepeatAttribute }={ i18n.T(ctx, "message.error.repeat") }
						{ BusyAttribute }={ i18n.T(ctx, "message.busy") }
						{ CapacityAttribute }={ i18n.T(ctx, "message.capacity") }
						class="text-caption text-danger sending:invisible"
					></p>
				}
				<p id={ MessageSendingID } role="status" class="absolute inset-0 text-caption text-muted"><span class="hidden sending:inline">{ i18n.T(ctx, "message.sending") }</span></p>
			</div>
			<button type="submit" aria-label={ i18n.T(ctx, "message.send") } class="flex size-11 shrink-0 items-center justify-center rounded-full bg-brand text-on-brand enabled:hover:bg-brand-hover transition-feedback motion-safe:active:scale-96 disabled:opacity-50">
				@Icon("send-regular", 20)
			</button>
		</div>
	</form>
	@typingForm(page, false)
}

// composerState holds what each answer renews; data-invalid is the field
// error the script copies to the textarea's aria-invalid.
templ composerState(page ChannelPage) {
	<div
		id={ MessageComposerStateID }
		{ SendKeyAttribute }={ sendKeyValue(page) }
		if page.PostedMessageID != nil {
			{ PostedMessageAttribute }={ MessageDOMID(*page.PostedMessageID) }
			{ PostedTopicAttribute }={ idValue(page.PostedTopicID) }
			{ PostedSeqAttribute }={ fmt.Sprint(page.PostedEventSeq) }
		}
		if page.SentBody != "" {
			{ SentBodyAttribute }={ page.SentBody }
		}
		if fieldError(page) != "" {
			{ InvalidAttribute }
		}
		class="sending:invisible"
	>
		if page.Composer != nil {
			<input type="hidden" name="composer" value={ *page.Composer }/>
		}
		if page.IdempotencyKey != nil {
			<input type="hidden" name="idempotency_key" value={ *page.IdempotencyKey }/>
		}
		if latest(page) && page.EventCursor != nil {
			<input type="hidden" name="cursor" value={ fmt.Sprint(*page.EventCursor) }/>
		}
		if fieldError(page) != "" {
			<p id={ MessageHelpID } role="alert" class="text-danger">{ i18n.T(ctx, fieldError(page)) }</p>
		} else if page.SendKey == "modifier_enter" {
			<p id={ MessageHelpID } class="text-caption text-muted">{ i18n.T(ctx, "message.help_modifier") }</p>
		} else {
			<p id={ MessageHelpID } class="text-caption text-muted">{ i18n.T(ctx, "message.help") }</p>
		}
	</div>
}

// fieldError is the help's error: none on a 409 the script recovers from.
func fieldError(page ChannelPage) string {
	if page.SentBody != "" {
		return ""
	}
	return page.BodyError
}

// A sibling isolates signal controls and synchronization from submission.
// Only the enhanced fragment replaces it out of band. htmx applies
// out-of-band swaps from any response, including the history page Load older
// fetches, which would install a generation no post ever closes.
templ typingForm(page ChannelPage, oob bool) {
	{{ _ = ctx }}
	<form
		id={ TypingFormID }
		hidden
		method="post"
		action={ typingURL(page) }
		if oob {
			hx-swap-oob="outerHTML"
		}
		if page.Composer != nil {
			hx-post={ typingURL(page) }
			hx-trigger={ TypingInputEvent + " throttle:2s queue:none" }
			hx-sync="this:drop"
			hx-swap="none"
		}
	>
		if page.Composer != nil {
			<input type="hidden" name="composer" value={ *page.Composer }/>
		}
	</form>
}

// readable reports whether the page has #read-form: only a latest page with
// reading wired and a snapshot cursor reads.
func readable(page ChannelPage) bool {
	return page.Reading && latest(page) && page.EventCursor != nil
}

// Automatic reading posts through this form, live arrivals included, so it
// stays when nothing was unread and only the button goes. Like the divider,
// the button follows the snapshot for the whole visit: live messages are read
// automatically once shown, and a page without JavaScript gets none. The
// snapshot bounds plain submissions; htmx uses the cursor of the shown DOM.
templ readForm(page ChannelPage) {
	// Below wide its button shows in the overview panel instead, at phone and
	// middle widths alike; automatic reading posts through the form at every width.
	<form id="read-form" method="post" action={ conversationURL(page) + "/read" } hx-post={ conversationURL(page) + "/read" } hx-trigger="read-visible, submit" hx-swap="none" hx-sync="this:drop" hidden?={ page.FirstUnread == 0 } class="max-wide:hidden">
		<input type="hidden" name="cursor" value={ fmt.Sprint(*page.EventCursor) }/>
		if page.FirstUnread > 0 {
			@submitButton(buttonSecondaryIcon, "reading.mark", submitValue{"scope", "all"}) {
				@Icon("checkmark-regular", 20)
			}
		}
	</form>
}

// SidebarLists replaces fresh lists whole, so topic displacement matches a reload.
templ SidebarLists(page ChannelPage) {
	// The topic list is nested in the channel list, so it is replaced with it.
	@ChannelList(page, true)
	if page.Topic != nil {
		@TopicHeadingCount(page, true)
	}
}

// ChannelList is shared by pages and member-dependent recounts.
templ ChannelList(page ChannelPage, oob bool) {
	<ul
		id={ SidebarChannelsID }
		{ SnapshotSeqAttribute }={ fmt.Sprint(page.SnapshotSeq) }
		class="flex flex-col gap-1"
		if oob {
			hx-swap-oob="true"
		}
	>
		for _, c := range page.Channels {
			@ChannelEntry(page.Organization.Slug, c, c.ID == page.Current.ID && page.Topic == nil, page.ChannelCounts[c.ID]) {
				if c.ID == page.Current.ID {
					@TopicList(page)
				}
			}
		}
		if !currentChannelListed(page) {
			<li>
				@TopicList(page)
			</li>
		}
	</ul>
}

// currentChannelListed reports whether the current channel has its own row,
// under which its topics are nested.
func currentChannelListed(page ChannelPage) bool {
	for _, c := range page.Channels {
		if c.ID == page.Current.ID {
			return true
		}
	}
	return false
}

// TopicList preserves the snapshot's bounded list, including its order.
templ TopicList(page ChannelPage) {
	<ul
		id={ SidebarTopicsID }
		aria-label={ i18n.T(ctx, "topic.list") }
		class="mb-1 ml-6 mt-0.5 flex flex-col gap-0.5 border-l border-border pl-2"
	>
		for _, topic := range page.Topics {
			@TopicEntry(page.Organization.Slug, page.Current.ID, topic, page.Topic != nil && page.Topic.ID == topic.ID, page.TopicCounts[topic.ID])
		}
	</ul>
}

// TopicHeadingCount keeps a target even while the selection is listed or at zero.
templ TopicHeadingCount(page ChannelPage, oob bool) {
	<span
		id={ TopicHeadingCountID }
		class="ml-2 max-desk:ml-0"
		if oob {
			hx-swap-oob="true"
		}
	>
		if !selectedTopicListed(page) {
			@unreadBadge(page.TopicCounts[page.Topic.ID])
		}
	</span>
}

// ChannelDOMID identifies a replaceable sidebar channel entry.
func ChannelDOMID(id kernel.ID) string {
	return fmt.Sprintf(ChannelDOMPrefix+"%x", id)
}

// TopicDOMID identifies a replaceable sidebar topic entry.
func TopicDOMID(id kernel.ID) string {
	return fmt.Sprintf(TopicDOMPrefix+"%x", id)
}

func selectedTopicListed(page ChannelPage) bool {
	for _, topic := range page.Topics {
		if page.Topic != nil && topic.ID == page.Topic.ID {
			return true
		}
	}
	return false
}

func unreadText(count int64) string {
	if count > 99 {
		return "99+"
	}
	return fmt.Sprint(count)
}

// ChannelEntry renders the whole sidebar entry for replacement by its stable ID.
templ ChannelEntry(slug string, channel Channel, selected bool, count int64) {
	<li id={ ChannelDOMID(channel.ID) }>
		<a
			id={ fmt.Sprintf(LinkChannelDOMPrefix+"%x", channel.ID) }
			href={ templ.SafeURL(ChannelURL(slug, channel.ID)) }
			if selected {
				aria-current="page"
			}
			class={ "relative flex min-h-9 items-center gap-2.5 max-desk:min-h-11 break-words rounded-lg px-3 py-1.5 transition-feedback motion-safe:active:scale-96", templ.KV("bg-selected font-semibold text-on-selected", selected), templ.KV("text-fg hover:bg-hover", !selected), templ.KV("font-semibold", !selected && count > 0) }
		>
			if selected {
				@selectionPill()
			}
			@channelImage(channel.ImageURL, false)
			<span dir="auto" class="min-w-0 flex-1">{ channel.Name }</span>
			@unreadBadge(count)
			@draftMarker()
		</a>
		{ children... }
	</li>
}

// TopicEntry renders the whole sidebar entry for replacement by its stable ID.
templ TopicEntry(slug string, channelID kernel.ID, topic Topic, selected bool, count int64) {
	<li id={ TopicDOMID(topic.ID) }>
		<a
			id={ fmt.Sprintf(LinkTopicDOMPrefix+"%x", topic.ID) }
			href={ templ.SafeURL(ConversationURL(slug, channelID, &topic.ID)) }
			if selected {
				aria-current="page"
			}
			class={ "relative flex min-h-8 items-center gap-2 max-desk:min-h-11 break-words rounded-md px-2.5 py-1 transition-feedback motion-safe:active:scale-96", templ.KV("bg-selected font-semibold text-on-selected", selected), templ.KV("text-muted hover:bg-hover hover:text-fg", !selected), templ.KV("font-semibold text-fg", !selected && count > 0) }
		>
			if selected {
				@selectionPill()
			}
			@Icon("branch-regular", 16)
			<span dir="auto" class="min-w-0 flex-1">{ topicName(ctx, topic) }</span>
			@unreadBadge(count)
			@draftMarker()
		</a>
	</li>
}

// selectionPill is the brand indicator of the current row; the row's text
// colour and weight say the same without colour (docs/ui-colours.md). It grows in
// only on arrival from another place (arrival-v1.js, docs/ui-motion.md#motion).
templ selectionPill() {
	{{ _ = ctx }}
	<span data-selection-pill aria-hidden="true" class="absolute left-0 top-1/2 h-4 w-0.75 -translate-y-1/2 rounded-full bg-brand"></span>
}

templ unreadBadge(count int64) {
	<span { UnreadCountAttribute }={ fmt.Sprint(count) } hidden?={ count == 0 } class="inline-flex min-w-5 shrink-0 justify-center rounded-full bg-brand px-1.5 text-caption font-semibold text-on-brand">
		<span aria-hidden="true">{ unreadText(count) }</span>
		<span class="sr-only">{ " " + strings.ReplaceAll(i18n.T(ctx, "reading.unread_count"), "{count}", unreadText(count)) }</span>
	</span>
}

templ draftMarker() {
	<span data-draft-marker hidden class="shrink-0 text-caption font-normal text-muted">{ i18n.T(ctx, "sidebar.draft") }</span>
}

func sendKeyValue(page ChannelPage) string {
	if page.SendKey == "modifier_enter" {
		return page.SendKey
	}
	return "enter"
}
