package view

import "github.com/tkakkie/ribbitto/internal/kernel"
import "github.com/tkakkie/ribbitto/internal/web/i18n"

templ resolvedMark(topic Topic) {
	if topic.ConclusionMessageID != (kernel.ID{}) {
		<span class="shrink-0 text-caption font-normal text-muted">{ i18n.T(ctx, "resolution.resolved") }</span>
	}
}

// TopicResolution links the current conclusion to its stable message URL.
templ TopicResolution(page ChannelPage) {
	<div
		id="resolution-summary"
		class="shrink-0 px-6 text-body max-desk:px-4"
	>
		if page.Conclusion != nil {
			<div class="flex flex-wrap items-center justify-between gap-2">
				<a href={ templ.SafeURL(page.Conclusion.URL) } class="inline-flex min-h-11 items-center text-brand underline">{ i18n.T(ctx, "resolution.conclusion") }</a>
				<form method="post" action={ templ.SafeURL(conversationURL(page) + "/reopen") }>
					<button type="submit" class="min-h-11 rounded-md px-3 text-brand hover:bg-hover">{ i18n.T(ctx, "resolution.reopen") }</button>
				</form>
			</div>
			<p dir="auto" class="max-h-32 overflow-y-auto whitespace-pre-wrap wrap-anywhere">{ page.Conclusion.Body }</p>
		}
	</div>
}
