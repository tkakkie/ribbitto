package view

import (
	"encoding/hex"
	"github.com/tkakkie/ribbitto/internal/kernel"
	"github.com/tkakkie/ribbitto/internal/web/i18n"
)

// Member holds the names and presence shown in the members panel.
type Member struct {
	ID                  kernel.ID
	DisplayName, Handle string
	Online              bool
}

// MemberPage is a bounded listing and its optional next-page cursor.
type MemberPage struct {
	Items         []Member
	Next          *kernel.ID
	PresenceAfter string
}

// PresenceDOMID identifies the same indicator in page and live markup.
func PresenceDOMID(id kernel.ID) string { return "presence-" + hex.EncodeToString(id[:]) }

// PresenceIndicator always labels its state; colour is a supplementary cue.
templ PresenceIndicator(id kernel.ID, online, live bool) {
	<span
		id={ PresenceDOMID(id) }
		class="ms-2 inline-flex items-center gap-1 text-caption text-muted"
		if live {
			hx-swap-oob="outerHTML"
		}
	>
		if online {
			<span class="h-2 w-2 rounded-full bg-success" aria-hidden="true"></span>
			{ i18n.T(ctx, "people.online") }
		} else {
			{ i18n.T(ctx, "people.offline") }
		}
	</span>
}

// membersPanel lists one bounded page of members in today's order; Next
// pages with the members' own after cursor, beside the conversation's.
templ membersPanel(page ChannelPage) {
	<ul id="members-list" class="flex flex-col gap-4 px-5 py-4">
		for _, member := range page.Members.Items {
			<li class="break-words">
				@MemberName(member.DisplayName, member.Handle)
				@PresenceIndicator(member.ID, member.Online, false)
			</li>
		}
	</ul>
	if len(page.Members.Items) == 0 {
		<p class="px-5 py-4 text-muted">{ i18n.T(ctx, "people.empty") }</p>
	}
	if page.Members.Next != nil {
		@textLink(panelURL(page, PanelMembers)+querySeparator(page)+"after="+idValue(*page.Members.Next), "people.next", "px-5 py-4")
	}
}
