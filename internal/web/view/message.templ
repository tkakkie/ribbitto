package view

import (
	"fmt"
	"time"

	"github.com/tkakkie/ribbitto/internal/kernel"
	"github.com/tkakkie/ribbitto/internal/web/i18n"
)

// Message holds the conversation fields rendered by a message item.
type Message struct {
	ID                  kernel.ID
	MemberID            kernel.ID
	TopicID             kernel.ID
	DisplayName, Handle string
	CreatedAt           time.Time
	Body                string
	EventSeq            int64
	TopicName           string
	DefaultTopic        bool
	// TopicURL is the topic view the label links to. It names the
	// organisation, channel and topic only, so live renders stay shared.
	TopicURL string
}

// MessageURL is one message's stable URL (decision 36): the slug and the
// message's UUID, never its channel or topic, which can change.
func MessageURL(slug string, id kernel.ID) string {
	return "/organizations/" + slug + "/messages/" + idValue(id)
}

// MessageDOMID is the stable DOM id shared by page and stream message items.
func MessageDOMID(id kernel.ID) string {
	return fmt.Sprintf("message-%x", id)
}

// MessageItem renders one chronological list item, including when sent alone.
templ MessageItem(entry Message) {
	@messageItem(entry, "")
}

// LiveMessageItem adds announcement text only for delivery over the stream.
templ LiveMessageItem(entry Message) {
	@messageItem(entry, i18n.T(ctx, "message.new")+" @"+entry.Handle+": "+entry.Body)
}

templ messageItem(entry Message, announcement string) {
	<li
		id={ MessageDOMID(entry.ID) }
		data-event-seq={ fmt.Sprint(entry.EventSeq) }
		if announcement != "" {
			data-announcement={ announcement }
		}
		// A message's URL lands on it (decision 36): :target highlights it
		// without JavaScript, and the outline widens the fill past the text
		// without moving it.
		class="relative flex scroll-mt-6 flex-col gap-1 pl-12 max-desk:wrap-anywhere target:rounded-sm target:bg-selected target:outline-8 target:outline-selected"
	>
		// Below desk the time sits under the name and the topic label and Select
		// stay together at the end, so a one-line message takes the 44 px target
		// row and its body line (#1093); Select keeps its width while a long
		// topic name wraps. The groups are display: contents from desk, which
		// keeps the desktop line as it was.
		<div class="flex flex-wrap items-baseline gap-x-2 gap-y-1 text-body max-desk:items-center">
			<div class="contents max-desk:flex max-desk:min-w-0 max-desk:flex-col">
				<span class="min-w-0 break-words">
					@MemberName(entry.DisplayName, entry.Handle)
				</span>
				// From desk the time keeps its width when message-time-v2.js
				// localises it, so the topic label and Select beside it do not
				// move (#1094). Below desk they sit at the row's end, and the
				// reserved width would push them to a row of their own.
				<time datetime={ entry.CreatedAt.UTC().Truncate(time.Millisecond).Format(time.RFC3339Nano) } data-local-time class="text-caption text-muted desk:min-w-timestamp desk:tabular-nums">{ entry.CreatedAt.UTC().Format("2006-01-02 15:04:05 UTC") }</time>
			</div>
			<div class="contents max-desk:ml-auto max-desk:flex max-desk:min-w-0 max-desk:items-center max-desk:gap-x-2">
				// A long topic name wraps at any width rather than widening the
				// reading column, which scrolls sideways at the desk breakpoint.
				<a href={ templ.SafeURL(entry.TopicURL) } class="inline-flex min-w-0 items-center gap-1 text-caption text-muted wrap-anywhere hover:text-brand max-desk:min-h-11 max-desk:min-w-11">
					@Icon("branch-regular", 20)
					<bdi class="min-w-0">
						if entry.DefaultTopic {
							{ i18n.T(ctx, "topic.default") }
						} else {
							{ entry.TopicName }
						}
					</bdi>
				</a>
				// Every checkbox shows the same label, so its message's body describes it.
				<label class="ml-auto inline-flex min-h-9 items-center gap-2 rounded-md px-2 text-caption text-muted hover:bg-hover max-desk:min-h-11 max-desk:shrink-0">
					<input type="checkbox" id={ "select-" + MessageDOMID(entry.ID) } form="branch-form" name="message" value={ idValue(entry.ID) + "/" + idValue(entry.TopicID) } data-source={ idValue(entry.TopicID) } aria-describedby={ "body-" + MessageDOMID(entry.ID) }/>
					{ i18n.T(ctx, "topic.branch_select") }
				</label>
			</div>
		</div>
		// Text precedes the avatar, whose fixed gutter reserves its space
		// without waiting for an image or font request.
		<p id={ "body-" + MessageDOMID(entry.ID) } dir="auto" class="whitespace-pre-wrap break-words text-title">{ entry.Body }</p>
		<div class="absolute left-0 top-0">
			@Avatar(entry.MemberID, entry.DisplayName, entry.Handle)
		</div>
	</li>
}

// MovedMessageItems carries replacement items without new-post announcements.
templ MovedMessageItems(entries []Message, from, to kernel.ID) {
	<ul data-from-topic={ idValue(from) } data-to-topic={ idValue(to) }>
		for _, entry := range entries {
			@MessageItem(entry)
		}
	</ul>
}
