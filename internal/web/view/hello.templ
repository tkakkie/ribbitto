package view

import "github.com/tkakkie/ribbitto/internal/web/i18n"

// Viewer describes who is looking at a page.
type Viewer struct {
	SignedIn    bool
	DisplayName string
	SignUpOpen  bool // only asked for a signed-out viewer
}

// Hello renders the initial page inside the shared layout.
templ Hello(stylesheetURL string, viewer Viewer) {
	@layout(stylesheetURL, i18n.T(ctx, "hello.page_title")) {
		@welcomeLayout() {
			<h1 class="text-display font-bold tracking-tight text-fg">{ i18n.T(ctx, "hello.title") }</h1>
			if viewer.SignedIn {
				<div class="flex flex-wrap items-center gap-3">
					<p class="text-body text-muted">
						{ i18n.T(ctx, "hello.signed_in_as") }
						<span class="font-semibold text-fg">{ viewer.DisplayName }</span>
					</p>
					@signOutButton(buttonWelcomeSecondary)
				</div>
			} else {
				<div class="flex flex-wrap gap-6">
					@textLink("/signin", "hello.sign_in", "text-body font-semibold")
					if viewer.SignUpOpen {
						@textLink("/signup", "signup.title", "text-body font-semibold")
					}
				</div>
			}
		}
	}
}

// SignOutButton is a form, because signing out changes state and so must be
// a POST.
templ SignOutButton() {
	@signOutButton(buttonSecondary)
}

// signOutButton shares the POST form while welcome pages choose a phone target.
templ signOutButton(kind buttonKind) {
	<form method="post" action="/signout">
		@submitButton(kind, "signout.submit")
	</form>
}
