package view

import "strconv"

// logoURL is the logo's one source: the favicon and brandLogo both use it,
// so replacing the logo changes one file and this reference (docs/ui.md).
const logoURL = "/static/brand/logo-v1.svg"

// brandLogo draws the ribbitto logo at size CSS pixels. alt is empty when
// the product name is shown next to it.
templ brandLogo(size int, alt string) {
	// templ's generated code reassigns ctx in every component; this one
	// needs no context, so mark it used for staticcheck (SA4006).
	{{ _ = ctx }}
	<img src={ logoURL } width={ strconv.Itoa(size) } height={ strconv.Itoa(size) } alt={ alt } decoding="async"/>
}
